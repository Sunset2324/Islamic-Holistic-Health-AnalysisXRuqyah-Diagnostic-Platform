# CONTOH SAJA. Berkas sungguhan dibuat di server oleh deploy/make-env.sh di /etc/myherbalis/api.env (izin 640, di luar repo).
# Jangan menyalin nilai asli ke repo, chat, atau tiket.
DATABASE_URL=postgres://myherbalis_api:GANTI@127.0.0.1:5432/myherbalis
HMAC_PEPPER=GANTI_openssl_rand_base64_32
DATA_KEY_V1=GANTI_openssl_rand_base64_32
DATA_KEY_CURRENT=1
PORT=3000
TRUST_PROXY=true
