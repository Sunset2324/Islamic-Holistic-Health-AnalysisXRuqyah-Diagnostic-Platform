# Salin ke server/.env (sudah di-gitignore). JANGAN commit nilai sungguhan dan jangan kirim ke siapa pun, termasuk ke AI.
# Buat nilai acak sendiri di komputermu:  openssl rand -base64 32

# Koneksi sebagai peran app_api (bukan superuser/pemilik skema).
DATABASE_URL=postgres://app_api:GANTI_PASSWORD@localhost:5432/myherbalis

# Pepper untuk HMAC token dan kode (minimal 32 byte, base64). Disimpan di luar database.
HMAC_PEPPER=GANTI_DENGAN_HASIL_openssl_rand_base64_32

# Kunci enkripsi data (tiap kunci 32 byte, base64). Untuk rotasi: tambah DATA_KEY_V2, ubah DATA_KEY_CURRENT=2.
# Jangan hapus kunci lama selama masih ada data yang terenkripsi dengannya.
DATA_KEY_V1=GANTI_DENGAN_HASIL_openssl_rand_base64_32
DATA_KEY_CURRENT=1

PORT=3000
# true bila di belakang reverse proxy tepercaya (agar IP asli dipakai untuk batas laju)
TRUST_PROXY=false
